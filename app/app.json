{
  "expo": {
    "name": "Puck",
    "slug": "puck",
    "scheme": "puck",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "@clerk/expo-google-signin",
      [
        "expo-notifications",
        {
          "defaultChannel": "puck-alerts",
          "color": "#3c241c"
        }
      ],
      "./plugins/withFullScreen",
      "./plugins/withWorkManagerProguard",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Puck uses the microphone so you can dictate a reply.",
          "speechRecognitionPermission": "Puck uses speech recognition to turn your dictated reply into text."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Puck uses the camera so you can attach a photo to a reply.",
          "photosPermission": "Puck uses your photos so you can attach a picture to a reply."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.puckit.app"
    },
    "android": {
      "package": "in.puckit.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
