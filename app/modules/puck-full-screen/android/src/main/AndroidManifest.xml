<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Puck plays an alert's ringtone itself (RingService), so another app's notification sound
       cannot cut it off the way it cuts off a notification's own sound. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <service
      android:name="puck.fullscreen.RingService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
    <!-- The live notification's "Show floating card": brings the card back, then closes. -->
    <activity
      android:name="puck.fullscreen.ShowFloatActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
  </application>
</manifest>
