{
  "name": "puck",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "app",
    "backend",
    "cli",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "machines:doc": "bun app/scripts/state-machines.ts",
    "machines:check": "bun app/scripts/state-machines.ts --check",
    "cli:build": "bun run --filter @puck/cli build",
    "release:install": "bun run --filter @puck/app release:install"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.0"
  }
}
