{
  "name": "puck",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "app",
    "app/modules/*",
    "backend",
    "cli",
    "desktop",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "machines:doc": "bun app/scripts/state-machines.ts",
    "machines:check": "bun app/scripts/state-machines.ts --check",
    "desktop:dev": "bun run --filter @puck/desktop dev",
    "desktop:build": "bun run --filter @puck/desktop build",
    "cli:build": "bun run --filter @puck/cli build",
    "release:install": "bun run --filter @puck/app release:install",
    "release:build": "bun scripts/release-build.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.0"
  },
  "patchedDependencies": {
    "electrobun@1.18.1": "patches/electrobun@1.18.1.patch"
  }
}
